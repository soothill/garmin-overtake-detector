[Unit]
Description=Hardened parallel Garmin front/rear processing and combined clips
StartLimitIntervalSec=1800
StartLimitBurst=5
OnSuccess=garmin-overtakes-review-skipped.service

[Service]
Type=simple
WorkingDirectory=%h/garmin-overtake-detector
Environment=GARMIN_BATCH_NAME=paired-parallel-v1
Environment=GARMIN_HEARTBEAT_TIMEOUT_SECONDS=300
Environment=GARMIN_MAX_SOURCE_FAILURES=3
Environment=GARMIN_MAX_COMPOSITION_FAILURES=3
Environment=GARMIN_COMPOSITION_WORKERS=3
EnvironmentFile=-%h/.config/garmin-overtake-detector/environment
ExecStartPre=-/usr/bin/docker rm -f garmin-overtakes-gpu-front garmin-overtakes-gpu-rear garmin-overtakes-composer garmin-overtakes-composer-1 garmin-overtakes-composer-2 garmin-overtakes-composer-3
ExecStart=%h/garmin-overtake-detector/batch-evox3.sh ${GARMIN_BATCH_NAME}
ExecStopPost=-/usr/bin/docker rm -f garmin-overtakes-gpu-front garmin-overtakes-gpu-rear garmin-overtakes-composer garmin-overtakes-composer-1 garmin-overtakes-composer-2 garmin-overtakes-composer-3
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=2 65
TimeoutStopSec=45
KillSignal=SIGTERM
KillMode=control-group
UMask=0022
SyslogIdentifier=garmin-overtakes-paired-parallel

[Install]
WantedBy=default.target
