[Unit]
Description=Recompose Garmin clips with front-left and rear-right layout
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/garmin-overtake-detector
EnvironmentFile=-%h/.config/garmin-overtake-detector/environment
ExecStartPre=-/usr/bin/docker rm -f garmin-overtakes-layout-recompose
ExecStart=%h/garmin-overtake-detector/recompose-layout-evox3.sh
ExecStopPost=-/usr/bin/docker rm -f garmin-overtakes-layout-recompose
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=65
TimeoutStartSec=infinity
TimeoutStopSec=45
KillMode=control-group
UMask=0022
SyslogIdentifier=garmin-overtakes-layout-recompose
